# AgentForge — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
# Random 32+ char secret. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# development | production
ENVIRONMENT=development
# How long JWTs stay valid (minutes). Default 1440 (24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# SQLite (dev, zero setup):
DATABASE_URL=sqlite:///./agentforge.db
# PostgreSQL (docker-compose / production):
# DATABASE_URL=postgresql+psycopg2://agentforge:agentforge@localhost:5432/agentforge

# --- LLM ---
# At least one required for full LLM-powered answers. Empty = demo responder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Tools ---
# Free at tavily.com — powers live web search inside agents.
TAVILY_API_KEY=

# --- Queue / Redis ---
REDIS_URL=redis://localhost:6379/0
# true when running the Celery worker; false for the built-in thread pool
USE_CELERY=false

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5

# --- CORS ---
# Comma-separated origins, or * for all (dev only)
CORS_ORIGINS=*

# --- Scheduler ---
SCHEDULER_ENABLED=true
